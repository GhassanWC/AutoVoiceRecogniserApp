# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
# Secret used to sign JWTs. Generate a long random string for production.
JWT_SECRET=change-me-in-production
# debug | info | warn | error
LOG_LEVEL=info

# ── Database (optional) ───────────────────────────────────────────────────────
# Leave unset to use in-memory storage (fine for development, data is lost on
# restart). Set a PostgreSQL URL for persistence, then run: npm run migrate
# DATABASE_URL=postgres://user:password@localhost:5432/live_translator

# ── Speech recognition provider ───────────────────────────────────────────────
# mock | openai | deepgram
# Production MVP: openai — OpenAI realtime transcription
# (gpt-4o-transcribe-diarize, far-field noise reduction, speaker diarization,
# NO source-language configuration: it transcribes whatever language it hears).
# deepgram remains available behind the same abstraction but is not required.
SPEECH_PROVIDER=openai
# OpenAI API key (may be the same project key as TRANSLATION_API_KEY).
SPEECH_API_KEY=
# Optional realtime model override. Default: gpt-4o-transcribe-diarize
# SPEECH_MODEL=

# ── Translation provider ──────────────────────────────────────────────────────
# mock | openai | google
# Production MVP: openai — also the authoritative source-language detector
# (returns {sourceLanguage, translatedText} from the actual text).
TRANSLATION_PROVIDER=openai
# Key for the chosen provider (may be the same OpenAI key as SPEECH_API_KEY).
TRANSLATION_API_KEY=
# Optional model override for openai. Default: gpt-4o-mini
# TRANSLATION_MODEL=

# ── Speaker detection ─────────────────────────────────────────────────────────
# heuristic | none   (heuristic = gap/language based speaker guessing, no ML)
DIARIZATION_PROVIDER=heuristic

# ── Usage limits & cost control ───────────────────────────────────────────────
# Hard cap on a single listening session, minutes.
MAX_SESSION_MINUTES=120
# Monthly processed-speech minutes per free user. 0 = unlimited.
FREE_MONTHLY_MINUTES=60
# Maximum length of one speech segment, seconds (longer segments are rejected).
MAX_SEGMENT_SECONDS=30
