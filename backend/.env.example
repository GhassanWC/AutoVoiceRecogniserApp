# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
# Secret used to sign JWTs. Generate a long random string for production.
JWT_SECRET=change-me-in-production
# debug | info | warn | error
LOG_LEVEL=info

# ── Database (optional) ───────────────────────────────────────────────────────
# Leave unset to use in-memory storage (fine for development, data is lost on
# restart). Set a PostgreSQL URL for persistence, then run: npm run migrate
# DATABASE_URL=postgres://user:password@localhost:5432/live_translator

# ── Speech recognition provider ───────────────────────────────────────────────
# mock | openai | deepgram
# Production should use deepgram: it enables the streaming pipeline (one live
# multilingual Deepgram WebSocket per session with real speaker diarization).
# openai/mock fall back to per-segment batch recognition.
SPEECH_PROVIDER=deepgram
# Key for the chosen provider (OpenAI or Deepgram API key). Not needed for mock.
SPEECH_API_KEY=
# Optional model override. Defaults: openai -> whisper-1, deepgram -> nova-3
# (nova-3 + language=multi is required for live multilingual code-switching;
# it currently covers en/es/fr/de/hi/ru/pt/ja/it/nl — see NOVA3_MULTI_LANGUAGES).
# SPEECH_MODEL=

# ── Translation provider ──────────────────────────────────────────────────────
# mock | openai | google
TRANSLATION_PROVIDER=mock
# Key for the chosen provider. Not needed for mock.
TRANSLATION_API_KEY=
# Optional model override for openai. Default: gpt-4o-mini
# TRANSLATION_MODEL=

# ── Speaker detection ─────────────────────────────────────────────────────────
# heuristic | none   (heuristic = gap/language based speaker guessing, no ML)
DIARIZATION_PROVIDER=heuristic

# ── Usage limits & cost control ───────────────────────────────────────────────
# Hard cap on a single listening session, minutes.
MAX_SESSION_MINUTES=120
# Monthly processed-speech minutes per free user. 0 = unlimited.
FREE_MONTHLY_MINUTES=60
# Maximum length of one speech segment, seconds (longer segments are rejected).
MAX_SEGMENT_SECONDS=30
