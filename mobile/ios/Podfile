# Committed deliberately (previously auto-generated at build time): the
# whisper_cpp_flutter_plus FFI bridge resolves its wf_* C symbols through
# dlsym(RTLD_DEFAULT, …), which only works reliably when the plugin is built
# as a DYNAMIC framework whose export table carries those symbols. Static
# linkage (SPM's default, or :linkage => :static) lets the linker drop the
# unreferenced bridge object from the Release archive → "Failed to lookup
# symbol 'wf_context_create'" at runtime. use_frameworks! below keeps plugin
# pods dynamic; the -u linker pins in Flutter/*.xcconfig turn any regression
# into a LINK-TIME failure instead of a TestFlight runtime failure.
platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # permission_handler_apple compiles each permission OUT unless its macro
    # is defined (PermissionHandlerEnums.h defaults PERMISSION_MICROPHONE to
    # 0). Without this a build reports microphone "denied" forever — even
    # while iOS Settings shows the permission granted. The app now reads the
    # OS state natively on iOS, but the plugin must still tell the truth
    # wherever it is consulted.
    if target.name == 'permission_handler_apple'
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_MICROPHONE=1'
      end
    end
  end
end
